# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env (in the project root) for local development.
# In production (Hugging Face Spaces), configure these as HF Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local dev only ────────────────────────────────────────────────────────────
# Makes backend modules importable when running from the project root
PYTHONPATH=./backend

# ── Environment ───────────────────────────────────────────────────────────────
# Values: dev | development | local | production
# In dev mode, CORS wildcard (*) is accepted automatically.
ENVIRONMENT=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For local dev you can use * (with ENVIRONMENT=dev); in production list exact origins.
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com,http://localhost:5173

# ── Supabase (server-side only — never expose service role key to the frontend) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
TEMPLATE_STORAGE_BUCKET=template-assets

# ── Template Editor feature flag ──────────────────────────────────────────────
FEATURE_TEMPLATE_EDITOR=true

# ── Ghostscript PDF post-compression (optional) ───────────────────────────────
# Set GHOSTSCRIPT_ENABLED=false to disable post-processing.
# Quality: screen (72dpi) | ebook (150dpi) | printer (300dpi) | prepress (300dpi+)
GHOSTSCRIPT_ENABLED=true
GHOSTSCRIPT_QUALITY=printer

# ── GTK Runtime — Windows only, for WeasyPrint (optional) ────────────────────
# Path to the GTK bin directory, e.g. C:\Program Files\GTK3-Runtime Win64\bin
GTK_RUNTIME_BIN=

# ── OCR ──────────────────────────────────────────────────────────────────────
# Motor por defecto al arrancar el servidor (puede sobreescribirse por petición
# desde el frontend sin reiniciar el Space).
#
# Valores:
#   rapidocr   — Motor local gratuito (RapidOCR + PyMuPDF). No necesita GPU.
#                Recomendado para HuggingFace Spaces. Extracción estructurada
#                basada en regex (sin LLM).
#
#   ollama-custom — Conecta a un servidor Ollama externo. Requiere un modelo
#                   de visión (llava, moondream, minicpm-v, etc.) y que el
#                   servidor sea accesible desde internet.
#                   Desde el frontend se puede configurar URL + modelo
#                   por petición sin cambiar esta variable.
#
OCR_BACKEND=rapidocr
OCR_REQUEST_TIMEOUT_SECONDS=180
OCR_MAX_UPLOAD_MB=25
OCR_PDF_DPI=220
OCR_MAX_PAGES=25

# ── Ollama (opcional) ─────────────────────────────────────────────────────────
# URL base del servidor Ollama. En HuggingFace Spaces localhost no funciona;
# usa un túnel público (ngrok, Cloudflare Tunnel, bore.pub…).
#
# IMPORTANTE — Ollama debe arrancar con:
#   OLLAMA_ORIGINS=* ollama serve
#
# Modelos recomendados para OCR (requieren capacidad de visión):
#   llava:latest          (~4 GB VRAM)  - uso general
#   llava-phi3:latest     (~2.5 GB)     - más rápido, menor RAM
#   llava:13b             (~8 GB)       - mayor precisión
#   moondream:latest      (~1.7 GB)     - muy rápido
#   minicpm-v:latest      (~5 GB)       - bueno en documentos
#
# Instalar un modelo: ollama pull llava:latest
#
OCR_OLLAMA_BASE_URL=http://127.0.0.1:11434
OCR_OLLAMA_MODEL_DEEPSEEK=deepseek-r1:7b
OCR_OLLAMA_MODEL_GLM=glm4:latest
OCR_OLLAMA_MODEL_CUSTOM=llava:latest
