# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env (in the project root) for local development.
# In production (Hugging Face Spaces), configure these as HF Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local dev only ────────────────────────────────────────────────────────────
# Makes backend modules importable when running from the project root
PYTHONPATH=./backend

# ── Environment ───────────────────────────────────────────────────────────────
# Values: dev | development | local | production
# In dev mode, CORS wildcard (*) is accepted automatically.
ENVIRONMENT=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For local dev you can use * (with ENVIRONMENT=dev); in production list exact origins.
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com,http://localhost:5173

# ── Supabase (server-side only — never expose service role key to the frontend) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
TEMPLATE_STORAGE_BUCKET=template-assets

# ── Template Editor feature flag ──────────────────────────────────────────────
FEATURE_TEMPLATE_EDITOR=true

# ── Ghostscript PDF post-compression (optional) ───────────────────────────────
# Set GHOSTSCRIPT_ENABLED=false to disable post-processing.
# Quality: screen (72dpi) | ebook (150dpi) | printer (300dpi) | prepress (300dpi+)
GHOSTSCRIPT_ENABLED=true
GHOSTSCRIPT_QUALITY=printer

# ── GTK Runtime — Windows only, for WeasyPrint (optional) ────────────────────
# Path to the GTK bin directory, e.g. C:\Program Files\GTK3-Runtime Win64\bin
GTK_RUNTIME_BIN=

# ── OCR (Mistral OCR) ─────────────────────────────────────────────────────────
# Motor OCR recomendado para PDFs escaneados e imagenes.
# Necesita una API key de Mistral (https://console.mistral.ai).
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.ai
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_REQUEST_TIMEOUT_SECONDS=180
OCR_MAX_UPLOAD_MB=25
