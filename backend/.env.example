# Public backend URL (Hugging Face Space)
BACKEND_PUBLIC_URL=https://your-space-name.hf.space

# Feature flags
FEATURE_TEMPLATE_EDITOR=true

# Supabase (server-side only, never expose service role to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
TEMPLATE_STORAGE_BUCKET=template-assets

# CORS hardening for public backend
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com,http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=false

