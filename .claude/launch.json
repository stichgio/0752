{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["backend/main.py"],
      "port": 7860
    },
    {
      "name": "npm-install",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd frontend && npm install --prefer-offline 2>&1 && echo INSTALL_DONE"],
      "port": 0
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--host"],
      "port": 5173,
      "cwd": "frontend"
    }
  ]
}
